# ==============================================================================
# Terraform Variables Example (Phase 6)
# ==============================================================================
# Copy this file to terraform.tfvars and fill in your values.
# DO NOT COMMIT terraform.tfvars CONTAINING REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Docker Daemon Connection
# Use "unix:///var/run/docker.sock" on Linux/WSL2
# Use "npipe:////./pipe/docker_engine" on Windows native PowerShell
docker_host           = "unix:///var/run/docker.sock"

# Resource Naming & Isolation
environment_prefix    = "taskmanager-tf"
network_name          = "taskmanager-tf-network"
volume_name           = "taskmanager-tf-logs"

# Image Tags (pre-built via Docker Compose or Jenkins pipeline)
backend_image         = "taskmanager-backend:latest"
frontend_image        = "taskmanager-frontend:latest"

# Host Ports (Configured to avoid collision with Compose: 3000/8080, K8s: 80, Jenkins: 8085)
backend_host_port     = 3001
backend_internal_port = 3000
frontend_host_port    = 8088
frontend_internal_port = 80

# Application Configuration
app_node_env          = "production"
app_log_level         = "info"
cors_origin           = "http://localhost:8088,http://localhost:8080,http://localhost"
admin_name            = "Admin"

# SENSITIVE VARIABLES (Placeholders only - replace in local terraform.tfvars)
database_url          = "postgresql://postgres:PLACEHOLDER_PASSWORD@db.placeholder.supabase.co:5432/postgres"
jwt_secret            = "PLACEHOLDER_JWT_SECRET_KEY_MIN_32_CHARS"
